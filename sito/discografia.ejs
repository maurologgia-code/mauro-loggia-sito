<%
  const orderMap = { 'Discografia': 0, 'Audiovisivo': 1, 'Stampa': 2 };
  const cats = [...new Set(discografia.items.map(i => i.category || 'Discografia'))]
                 .sort((a, b) => (orderMap[a] ?? 9) - (orderMap[b] ?? 9));
%><!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Discografia & Crediti — Mauro Loggia | Sound Engineer, Produttore</title>
  <meta name="description" content="Discografia e crediti di Mauro Loggia: produzioni, registrazioni e mix pubblicati. Ogni titolo rimanda alla pubblicazione (Discogs, Spotify, Qobuz e altre).">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://maurologgia.com/discografia">

  <meta property="og:type"        content="website">
  <meta property="og:url"         content="https://maurologgia.com/discografia">
  <meta property="og:title"       content="Discografia & Crediti — Mauro Loggia">
  <meta property="og:description" content="Produzioni, registrazioni e mix pubblicati, con link alle pubblicazioni.">
  <meta property="og:locale"      content="it_IT">

  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap"
        media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap">
  </noscript>

  <link rel="stylesheet" href="styles.css">
</head>

<body>

  <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

  <!-- NAVIGAZIONE -->
  <header class="nav nav--solid" role="banner">
    <div class="nav__inner">
      <a href="/" class="nav__logo" aria-label="Mauro Loggia — torna alla home">
        Mauro Loggia<span>.</span>
      </a>
      <nav aria-label="Navigazione principale">
        <ul class="nav__links" role="list">
          <li><a href="/#chi-sono"   class="nav__link">Chi sono</a></li>
          <li><a href="/#servizi"    class="nav__link">Servizi</a></li>
          <li><a href="/esperienza"  class="nav__link">Esperienza</a></li>
          <li><a href="/#portfolio"  class="nav__link">Portfolio</a></li>
          <li><a href="/discografia" class="nav__link" aria-current="page">Crediti</a></li>
          <li><a href="/galleria"    class="nav__link">Galleria</a></li>
          <li><a href="/#stampa"     class="nav__link">Stampa</a></li>
          <li><a href="/#contatti"   class="nav__cta">Contattami</a></li>
        </ul>
      </nav>
      <button class="nav__toggle"
              aria-label="Apri il menu di navigazione"
              aria-expanded="false"
              aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav id="mobile-nav" class="nav__mobile" aria-label="Menu mobile">
      <a href="/#chi-sono"   class="nav__link">Chi sono</a>
      <a href="/#servizi"    class="nav__link">Servizi</a>
      <a href="/esperienza"  class="nav__link">Esperienza</a>
      <a href="/#portfolio"  class="nav__link">Portfolio</a>
      <a href="/discografia" class="nav__link" aria-current="page">Crediti</a>
      <a href="/galleria"    class="nav__link">Galleria</a>
      <a href="/#stampa"     class="nav__link">Stampa</a>
      <a href="/#contatti"   class="nav__cta">Contattami</a>
    </nav>
  </header>

  <main id="main-content">

    <section class="section gallery-page" aria-labelledby="discografia-title">
      <div class="container">

        <a href="/" class="btn btn--outline gallery-page__back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          Torna alla home
        </a>

        <span class="section__label reveal">Lavori pubblicati</span>
        <h1 class="section__title reveal reveal--delay-1" id="discografia-title">Discografia &amp; Crediti</h1>
        <% if (discografia.intro) { %>
        <p class="section__intro reveal reveal--delay-2"><%- discografia.intro %></p>
        <% } %>

        <% cats.forEach(function(cat) {
           const list = discografia.items.filter(i => (i.category || 'Discografia') === cat);
           if (!list.length) return;
        %>
        <% if (cats.length > 1) { %>
        <h2 class="disco-group__title reveal"><%= cat %></h2>
        <% } %>
        <ul class="disco-list reveal" role="list">
          <% list.forEach(function(item) { %>
          <li>
            <a class="disco-item" href="<%= item.url %>" target="_blank" rel="noopener noreferrer">
              <span class="disco-item__main">
                <span class="disco-item__title"><%- item.title %></span>
                <% if (item.role) { %><span class="disco-item__role"><%- item.role %></span><% } %>
              </span>
              <svg class="disco-item__ext" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </li>
          <% }); %>
        </ul>
        <% }); %>

        <div class="gallery-page__footer-back">
          <a href="/" class="btn btn--primary">
            Torna alla home
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>

      </div>
    </section>

  </main>


  <!-- FOOTER -->
  <footer class="footer" role="contentinfo">
    <div class="container">
      <div class="footer__inner">
        <span class="footer__name">Mauro Loggia</span>
        <p class="footer__copy">© <span id="footer-year"></span> Mauro Loggia. Tutti i diritti riservati.</p>
        <nav class="footer__links" aria-label="Link footer">
          <a href="mailto:info@maurologgia.com" class="footer__link">Email</a>
          <a href="https://www.linkedin.com/in/mauro-loggia-b241233/" class="footer__link"
             target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://scuolaapm.it/" class="footer__link"
             target="_blank" rel="noopener noreferrer">Scuola APM</a>
        </nav>
        <a href="/" class="footer__back" aria-label="Torna alla home">
          Torna alla home
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="18 15 12 9 6 15"/>
          </svg>
        </a>
      </div>
    </div>
  </footer>

  <script src="script.js"></script>
  <script>document.getElementById('footer-year').textContent = new Date().getFullYear();</script>

</body>
</html>
