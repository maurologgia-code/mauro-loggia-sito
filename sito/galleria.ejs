<%
/* Helper: ricava l'embed e l'anteprima da un elemento della galleria */
function ytId(u) {
  const m = (u || '').match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/)|youtu\.be\/)([\w-]{6,})/);
  return m ? m[1] : '';
}
function vimeoId(u) {
  const m = (u || '').match(/vimeo\.com\/(?:video\/)?(\d+)/);
  return m ? m[1] : '';
}
function mediaInfo(item) {
  const type = item.type || 'foto';
  if (type === 'video') {
    const url = (item.url || '').trim();
    const cover = item.cover || '';
    const yt = ytId(url);
    if (yt) {
      return { kind: 'video', embed: 'https://www.youtube.com/embed/' + yt + '?rel=0',
               thumb: cover || ('https://img.youtube.com/vi/' + yt + '/hqdefault.jpg') };
    }
    const vi = vimeoId(url);
    if (vi) {
      return { kind: 'video', embed: 'https://player.vimeo.com/video/' + vi, thumb: cover };
    }
    return { kind: 'video', embed: '', thumb: cover };
  }
  if (type === 'audio') {
    const url = (item.url || '').trim();
    const cover = item.cover || '';
    const embed = 'https://w.soundcloud.com/player/?url=' + encodeURIComponent(url) +
                  '&color=%23c89a3a&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=false';
    return { kind: 'audio', embed, thumb: cover };
  }
  return { kind: 'image', embed: '', thumb: item.photo || '' };
}

const mediaIcons = {
  video: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
  audio: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  play:  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>'
};
%><!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Galleria — Mauro Loggia | Sound Engineer, Produttore, Formatore</title>
  <meta name="description" content="Galleria fotografica di Mauro Loggia: momenti di lavoro tra studio di registrazione, riprese dal vivo, produzioni e attività didattiche.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://maurologgia.com/galleria">

  <meta property="og:type"        content="website">
  <meta property="og:url"         content="https://maurologgia.com/galleria">
  <meta property="og:title"       content="Galleria — Mauro Loggia">
  <meta property="og:description" content="Momenti di lavoro tra studio, palco e aula.">
  <meta property="og:locale"      content="it_IT">

  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap"
        media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap">
  </noscript>

  <link rel="stylesheet" href="styles.css">
</head>

<body>

  <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

  <!-- NAVIGAZIONE -->
  <header class="nav nav--solid" role="banner">
    <div class="nav__inner">
      <a href="/" class="nav__logo" aria-label="Mauro Loggia — torna alla home">
        Mauro Loggia<span>.</span>
      </a>
      <nav aria-label="Navigazione principale">
        <ul class="nav__links" role="list">
          <li><a href="/#chi-sono"   class="nav__link">Chi sono</a></li>
          <li><a href="/#servizi"    class="nav__link">Servizi</a></li>
          <li><a href="/#esperienza" class="nav__link">Esperienza</a></li>
          <li><a href="/#portfolio"  class="nav__link">Portfolio</a></li>
          <li><a href="/galleria"    class="nav__link" aria-current="page">Galleria</a></li>
          <li><a href="/#stampa"     class="nav__link">Stampa</a></li>
          <li><a href="/#contatti"   class="nav__cta">Contattami</a></li>
        </ul>
      </nav>
      <button class="nav__toggle"
              aria-label="Apri il menu di navigazione"
              aria-expanded="false"
              aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav id="mobile-nav" class="nav__mobile" aria-label="Menu mobile">
      <a href="/#chi-sono"   class="nav__link">Chi sono</a>
      <a href="/#servizi"    class="nav__link">Servizi</a>
      <a href="/#esperienza" class="nav__link">Esperienza</a>
      <a href="/#portfolio"  class="nav__link">Portfolio</a>
      <a href="/galleria"    class="nav__link" aria-current="page">Galleria</a>
      <a href="/#stampa"     class="nav__link">Stampa</a>
      <a href="/#contatti"   class="nav__cta">Contattami</a>
    </nav>
  </header>

  <main id="main-content">

    <section class="section gallery-page" aria-labelledby="galleria-title">
      <div class="container">

        <a href="/" class="btn btn--outline gallery-page__back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          Torna alla home
        </a>

        <span class="section__label reveal">Immagini</span>
        <h1 class="section__title reveal reveal--delay-1" id="galleria-title">Galleria</h1>
        <% if (galleria.intro) { %>
        <p class="section__intro reveal reveal--delay-2"><%- galleria.intro %></p>
        <% } %>

        <div class="gallery__grid reveal reveal--delay-2">
          <% galleria.items.forEach(function(item, i) {
             const m = mediaInfo(item);
             const caption = item.caption || '';
             const hasThumb = !!m.thumb;
             const aria = m.kind === 'video' ? 'Riproduci video'
                        : m.kind === 'audio' ? 'Ascolta audio'
                        : 'Ingrandisci immagine';
          %>
          <button type="button"
                  class="gallery__item gallery__item--<%= m.kind %><%= hasThumb ? '' : ' gallery__item--placeholder' %>"
                  data-kind="<%= m.kind %>"
                  <% if (m.kind === 'image') { %>data-full="<%- encodeURI(item.photo) %>"<% } else { %>data-embed="<%= m.embed %>"<% } %>
                  data-caption="<%= caption %>"
                  aria-label="<%= aria %><%= caption ? ': ' + caption : '' %>">
            <% if (hasThumb) { %>
            <img src="<%- encodeURI(m.thumb) %>" alt="<%= caption || 'Elemento della galleria' %>" loading="lazy">
            <% } else { %>
            <span class="gallery__placeholder"><%- mediaIcons[m.kind] || mediaIcons.video %></span>
            <% } %>
            <% if (m.kind === 'video') { %>
            <span class="gallery__play" aria-hidden="true"><%- mediaIcons.play %></span>
            <% } else if (m.kind === 'audio') { %>
            <span class="gallery__media-badge" aria-hidden="true"><%- mediaIcons.audio %></span>
            <% } %>
            <% if (caption) { %>
            <span class="gallery__caption"><%= caption %></span>
            <% } %>
          </button>
          <% }); %>
        </div>

        <div class="gallery-page__footer-back">
          <a href="/" class="btn btn--primary">
            Torna alla home
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>

      </div>
    </section>

  </main>


  <!-- FOOTER -->
  <footer class="footer" role="contentinfo">
    <div class="container">
      <div class="footer__inner">
        <span class="footer__name">Mauro Loggia</span>
        <p class="footer__copy">© <span id="footer-year"></span> Mauro Loggia. Tutti i diritti riservati.</p>
        <nav class="footer__links" aria-label="Link footer">
          <a href="mailto:mauro.loggia@gmail.com" class="footer__link">Email</a>
          <a href="https://www.linkedin.com/in/mauro-loggia-b241233/" class="footer__link"
             target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://scuolaapm.it/" class="footer__link"
             target="_blank" rel="noopener noreferrer">Scuola APM</a>
        </nav>
        <a href="/" class="footer__back" aria-label="Torna alla home">
          Torna alla home
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="18 15 12 9 6 15"/>
          </svg>
        </a>
      </div>
    </div>
  </footer>

  <!-- LIGHTBOX GALLERIA -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Immagine ingrandita" hidden>
    <button type="button" class="lightbox__close" aria-label="Chiudi">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Immagine precedente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" src="" alt="" hidden>
      <div class="lightbox__embed" hidden>
        <iframe class="lightbox__iframe" src="" title="Contenuto multimediale"
                allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
                allowfullscreen loading="lazy"></iframe>
      </div>
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Immagine successiva">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
  </div>

  <script src="script.js"></script>
  <script>document.getElementById('footer-year').textContent = new Date().getFullYear();</script>

</body>
</html>
