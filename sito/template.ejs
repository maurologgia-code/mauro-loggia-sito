    <!-- 2. CHI SONO -->
    <section id="chi-sono" class="section" aria-labelledby="chi-sono-title">
      <div class="container">
        <span class="section__label reveal">Profilo</span>
        <h2 class="section__title reveal reveal--delay-1" id="chi-sono-title">Chi sono</h2>

        <div class="about__grid">
          <div class="about__image-wrap reveal reveal--left">
            <img src="<%- encodeURI(chiSono.photo) %>"
                 alt="<%- chiSono.photo_alt %>"
                 width="600" height="800" loading="lazy">
          </div>

          <div class="about__text">
            <div class="about__bio reveal">
              <p><%- chiSono.bio_p1 %></p>
              <p><%- chiSono.bio_p2 %></p>
            </div>

            <div class="about__expander reveal reveal--delay-1">
              <button class="about__expander-btn"
                      aria-expanded="false"
                      aria-controls="bio-estesa">
                <span class="expander-label">Leggi di più</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <div id="bio-estesa" class="about__bio-extended" role="region" aria-label="Biografia estesa">
                <div class="about__bio-extended-inner">
                  <% chiSono.bio_extended.forEach(function(par) { %>
                  <p><%- par %></p>
                  <% }); %>
                </div>
              </div>
            </div>

            <div class="about__stats reveal reveal--delay-2" aria-label="Dati chiave">
              <% chiSono.stats.forEach(function(stat) { %>
              <div class="about__stat">
                <span class="about__stat-value"><%- stat.value %></span>
                <span class="about__stat-label"><%- stat.label %></span>
              </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- 3. SERVIZI -->
    <section id="servizi" class="section section--alt" aria-labelledby="servizi-title">
      <div class="container">
        <span class="section__label reveal">Cosa faccio</span>
        <h2 class="section__title reveal reveal--delay-1" id="servizi-title">Servizi di consulenza</h2>
        <p class="section__intro reveal reveal--delay-2"><%- servizi.intro %></p>

        <div class="services__grid">
          <% servizi.cards.forEach(function(card, i) { %>
          <article class="service-card reveal reveal--delay-<%= i+1 %>">
            <div class="service-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><%- svgIcons[card.icon] || svgIcons.mic %></svg>
            </div>
            <h3 class="service-card__title"><%- card.title_line1 %><br><%- card.title_line2 %></h3>
            <p class="service-card__desc"><%- card.desc %></p>
            <p class="service-card__target"><strong>Per:</strong> <%- card.target %></p>
            <a href="#contatti" class="service-card__cta">
              Parliamone
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </article>
          <% }); %>
        </div>
      </div>
    </section>


    <!-- 4. ESPERIENZA -->
    <section id="esperienza" class="section" aria-labelledby="esperienza-title">
      <div class="container">
        <span class="section__label reveal">Percorso</span>
        <h2 class="section__title reveal reveal--delay-1" id="esperienza-title">Esperienza & Didattica</h2>
        <p class="section__intro reveal reveal--delay-2"><%- esperienza.intro %></p>

        <div class="timeline reveal">
          <% esperienza.items.forEach(function(item) { %>
          <article class="timeline__item<%= item.featured ? ' timeline__item--featured' : '' %>">
            <div class="timeline__dot" aria-hidden="true"></div>
            <% if (item.featured && item.badge) { %>
            <span class="timeline__badge"><%- item.badge %></span>
            <% } %>
            <time class="timeline__year"><%- item.year %></time>
            <h3 class="timeline__title"><%- item.title %></h3>
            <p class="timeline__subtitle"><%- item.subtitle %></p>
            <p class="timeline__desc"><%- item.desc %></p>
          </article>
          <% }); %>
        </div>
      </div>
    </section>


    <!-- 5. PORTFOLIO -->
    <section id="portfolio" class="section section--alt" aria-labelledby="portfolio-title">
      <div class="container">
        <span class="section__label reveal">Lavori selezionati</span>
        <h2 class="section__title reveal reveal--delay-1" id="portfolio-title">Portfolio</h2>
        <p class="section__intro reveal reveal--delay-2"><%- portfolio.intro %></p>

        <div class="portfolio__grid">
          <% portfolio.cards.forEach(function(card, i) {
             const delay = (i % 3) + 1;
             const featuredClass = card.featured ? ' portfolio__card--featured' : '';
          %>
          <article class="portfolio__card<%= featuredClass %> reveal reveal--delay-<%= i === 0 ? '' : delay %>">
            <img src="<%- encodeURI(card.photo) %>"
                 alt="<%- card.photo_alt %>"
                 width="<%= card.featured ? '1200' : '600' %>"
                 height="<%= card.featured ? '600' : '450' %>"
                 loading="lazy">
            <div class="portfolio__overlay">
              <span class="portfolio__badge"><%- card.badge %></span>
              <h3 class="portfolio__title"><%- card.title %></h3>
              <p class="portfolio__role"><%- card.role %></p>
              <% if (card.link_text && card.link_url) { %>
              <a href="<%- card.link_url %>"
                 class="portfolio__link"
                 target="_blank"
                 rel="noopener noreferrer"
                 aria-label="<%- card.link_text %> (apre in una nuova finestra)">
                <%- card.link_text %>
                <%- extLink %>
              </a>
              <% } %>
            </div>
          </article>
          <% }); %>
        </div>
      </div>
    </section>


    <!-- 6. STAMPA -->
    <section id="stampa" class="section" aria-labelledby="stampa-title">
      <div class="container">
        <span class="section__label reveal">Rassegna stampa</span>
        <h2 class="section__title reveal reveal--delay-1" id="stampa-title">Stampa & Riconoscimenti</h2>

        <div class="press__grid">
          <% stampa.items.forEach(function(item, i) { %>
          <article class="press__card reveal reveal--delay-<%= i+1 %>">
            <div class="press__quote-mark" aria-hidden="true">"</div>
            <blockquote class="press__quote"><%- item.quote %></blockquote>
            <footer class="press__meta">
              <div>
                <span class="press__source"><%- item.source %></span>
                <span class="press__year"> — <%- item.year %></span>
              </div>
            </footer>
          </article>
          <% }); %>
        </div>
      </div>
    </section>


    <!-- 7. CONTATTI -->
    <section id="contatti" class="section section--alt" aria-labelledby="contatti-title">
      <div class="container">
        <span class="section__label reveal">Parliamo</span>
        <h2 class="section__title reveal reveal--delay-1" id="contatti-title">Contatti</h2>

        <div class="contact__grid">
          <div class="contact__form reveal">
            <form action="https://formspree.io/f/PLACEHOLDER" method="POST" novalidate>
              <input type="hidden" name="_subject" value="Contatto dal sito — maurologgia.it">

              <div class="form__group">
                <label class="form__label" for="nome">Nome e cognome</label>
                <input class="form__input" type="text" id="nome" name="nome"
                       autocomplete="name" required aria-required="true" placeholder="Il tuo nome">
              </div>
              <div class="form__group">
                <label class="form__label" for="email">Email</label>
                <input class="form__input" type="email" id="email" name="email"
                       autocomplete="email" required aria-required="true" placeholder="la.tua@email.com">
              </div>
              <div class="form__group">
                <label class="form__label" for="messaggio">Messaggio</label>
                <textarea class="form__textarea" id="messaggio" name="messaggio"
                          required aria-required="true"
                          placeholder="Raccontami il tuo progetto o la tua richiesta…"
                          rows="5"></textarea>
              </div>

              <div class="form__feedback" role="alert" aria-live="polite"></div>

              <button type="submit" class="btn btn--primary form__submit">
