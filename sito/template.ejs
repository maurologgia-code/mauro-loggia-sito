</head>

<body>

  <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

  <!-- NAVIGAZIONE -->
  <header class="nav" role="banner">
    <div class="nav__inner">
      <a href="#hero" class="nav__logo" aria-label="Mauro Loggia — torna in cima">
        Mauro Loggia<span>.</span>
      </a>
      <nav aria-label="Navigazione principale">
        <ul class="nav__links" role="list">
          <li><a href="#chi-sono"   class="nav__link">Chi sono</a></li>
          <li><a href="#servizi"    class="nav__link">Servizi</a></li>
          <li><a href="#esperienza" class="nav__link">Esperienza</a></li>
          <li><a href="#portfolio"  class="nav__link">Portfolio</a></li>
          <li><a href="#stampa"     class="nav__link">Stampa</a></li>
          <li><a href="#contatti"   class="nav__cta">Contattami</a></li>
        </ul>
      </nav>
      <button class="nav__toggle"
              aria-label="Apri il menu di navigazione"
              aria-expanded="false"
              aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav id="mobile-nav" class="nav__mobile" aria-label="Menu mobile">
      <a href="#chi-sono"   class="nav__link">Chi sono</a>
      <a href="#servizi"    class="nav__link">Servizi</a>
      <a href="#esperienza" class="nav__link">Esperienza</a>
      <a href="#portfolio"  class="nav__link">Portfolio</a>
      <a href="#stampa"     class="nav__link">Stampa</a>
      <a href="#contatti"   class="nav__cta">Contattami</a>
    </nav>
  </header>

  <main id="main-content">

    <!-- 1. HERO -->
    <section id="hero" class="hero" aria-label="Introduzione">
      <div class="hero__content">
        <span class="hero__eyebrow"><%- hero.eyebrow %></span>
        <h1 class="hero__name">Mauro<br>Loggia</h1>
        <p class="hero__role">
          <%- hero.role_place %> —
          <span><%- hero.role_year %></span>
        </p>
        <p class="hero__claim">"<%- hero.claim %>"</p>
        <p class="hero__desc"><%- hero.description %></p>

        <div class="hero__actions">
          <a href="#contatti" class="btn btn--primary">
            Scrivimi
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
          <a href="cv/Mauro-Loggia-CV.pdf" download class="btn btn--outline"
             aria-label="Scarica il curriculum vitae in formato PDF">
            Scarica CV
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
        </div>

        <div class="hero__stats" aria-label="Dati principali">
          <% hero.stats.forEach(function(stat) { %>
          <div class="hero__stat">
            <span class="hero__stat-value"><%- stat.value %></span>
            <span class="hero__stat-label"><%- stat.label_line1 %><br><%- stat.label_line2 %></span>
          </div>
          <% }); %>
        </div>
      </div>

      <div class="hero__image-wrap">
        <img src="<%- encodeURI(hero.photo) %>"
             alt="<%- hero.photo_alt %>"
             width="800" height="900"
             loading="eager" fetchpriority="high">
      </div>
    </section>


